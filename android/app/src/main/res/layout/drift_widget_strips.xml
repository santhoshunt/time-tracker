<?xml version="1.0" encoding="utf-8"?>
<!-- Drift plan and actual (4x2): "Today 74%" and the clock, then one bitmap
     with the plan strip, the actual strip, the now line and the hour ticks
     (DriftWidgets.stripBitmap, drawn at this ImageView's exact size), then
     the drift and "updated 14:05" when the snapshot is old. Where the system
     refuses the bitmap, dw_strip_text says the same in words. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/dw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/drift_widget_bg"
        android:tint="#181B1E" />

    <ImageView
        android:id="@+id/dw_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/drift_widget_border"
        android:tint="#272B30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/dw_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dw_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F0F4FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dw_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="#AAB8D4"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/dw_strip"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/dw_strip_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F0F4FF"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dw_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dw_drift"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#AAB8D4"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dw_stale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="#AAB8D4"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#F0F4FF"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
