<?xml version="1.0" encoding="utf-8"?>
<!-- Drift score (2x2): the score ring (a bitmap from DriftWidgets.ringBitmap,
     scaled into the room the caption leaves), the percent in its centre,
     and the current block and its time left underneath, on one line or two
     as the width allows. DriftWidgets.ring sizes the centre text to the
     ring and sets every colour and visibility on each update. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/dw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/drift_widget_bg"
        android:tint="#181B1E" />

    <ImageView
        android:id="@+id/dw_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/drift_widget_border"
        android:tint="#272B30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/dw_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dw_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F0F4FF"
                    android:textSize="22dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dw_percent_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="on track"
                    android:textColor="#AAB8D4"
                    android:textSize="10dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/dw_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#F0F4FF"
            android:textSize="12sp" />

        <!-- The caption's second part ("42 min left") on its own line, where
             the whole caption does not fit on one. -->
        <TextView
            android:id="@+id/dw_caption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AAB8D4"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dw_stale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AAB8D4"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
