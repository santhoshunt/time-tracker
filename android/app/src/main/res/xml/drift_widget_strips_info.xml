<?xml version="1.0" encoding="utf-8"?>
<!-- Drift plan and actual (4x2). updatePeriodMillis: a 30-minute redraw from
     the stored snapshot, so the now line and the clock move on without the
     app running. No configure step. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/drift_widget_strips_description"
    android:initialLayout="@layout/drift_widget_strips"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/drift_widget_strips_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
